# ============ DeepSeek LLM 配置 ============
# 获取方式：https://platform.deepseek.com/  -> API Keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# 模型：deepseek-chat（V3 对话）或 deepseek-reasoner（R1 推理，慢但分析强）
DEEPSEEK_MODEL=deepseek-chat

# ============ LangSmith 可观测性配置 ============
# 获取方式：https://smith.langchain.com/  -> Settings -> API Keys
# 不配置则自动关闭 tracing（不影响运行）
LANGSMITH_API_KEY=lsv2_xxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=quant-research-agent
# 置 true 开启 tracing（上传到 LangSmith），无 key 时保持 false
LANGSMITH_TRACING=false

# ============ 运行模式 ============
# mock: 不调用真实 LLM（无 API key 也能跑通全图，验证编排逻辑）
# live: 调用 DeepSeek 真实推理
QUANT_AGENT_MODE=mock

# ============ V2：Tushare 真实数据源 ============
# 获取方式：https://tushare.pro/ 注册 -> 个人主页 -> 接口TOKEN
# 配置后 ingest 自动走 TushareProvider（沪深300成分股公告/新闻/研报/指数权重/日线）
# 未配置则回退 FileProvider（本地 data/sample_announcements.csv，仅开发验证）
TUSHARE_TOKEN=

# ============ V2：PostgreSQL / pgvector 数据库 ============
# 默认值对应 docker-compose.db.yml 中 quant-pgvector 容器
QUANT_DB_DSN=postgresql://quant:quant_pass_2026@localhost:5432/quantdb

# ============ V2：嵌入模型 ============
# 默认 bge-small-zh-v1.5（512 维，中文金融场景，与 pgvector vector(512) + HNSW 匹配）
# 首次使用自动下载（~100MB，中国大陆自动走 hf-mirror 镜像）
QUANT_EMBED_MODEL=BAAI/bge-small-zh-v1.5
